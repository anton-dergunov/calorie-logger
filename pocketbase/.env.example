# PocketBase version, local listener, and paths. Do not put application or
# superuser credentials in this file.
PB_VERSION=0.39.10
PB_BIND_ADDRESS=127.0.0.1
PB_PORT=8090
PB_DATA_PATH=./pb_data
# The published macOS application, served from its own route rather than from
# pb_public, which the installed web app precaches in full.
CALORIE_LOGGER_DOWNLOADS_PATH=./downloads

# Written by the deployment so /health can report which build is running.
CALORIE_LOGGER_VERSION=
CALORIE_LOGGER_BUILD=

# The food estimator. Keep the real key in secrets.env in the install root,
# outside every release, never here. AI_PROVIDER is "gemini" or "openai";
# "openai" means the chat-completions shape, which OpenRouter, Groq, and a
# local Ollama also speak. Without a key, everything except estimating a
# described or photographed portion works.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
